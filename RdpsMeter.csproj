<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>RdpsMeter</RootNamespace>
    <AssemblyName>RdpsMeter</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- The self-test harness (SelfTest, AutoHarness, and their NoOpChoiceContext) is developer-only and must NOT ship.
       NoOpChoiceContext subclasses a game type whose abstract surface changes between game versions, so a shipped copy
       fails to load on any version it wasn't built against - and because the game's own mod loader reflects over the
       whole assembly to find the entry point, one unloadable type takes the entire mod down before it initializes.
       Build with -p:Harness=true to compile the harness in for headless self-testing; release builds leave it out. -->
  <PropertyGroup Condition="'$(Harness)' == 'true'">
    <DefineConstants>$(DefineConstants);RDPS_HARNESS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shipped by the game itself at runtime - reference only, do not copy to our output. -->
    <Reference Include="sts2">
      <HintPath>lib/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>lib/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="RdpsMeter.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The meter's own translations, compiled into the dll: a release ships only the dll and the manifest, so a table
       left as a loose file would not reach players. Named explicitly rather than by the default path-derived rule, so
       Loc can ask for "RdpsMeter.localization.<lang>.json" and get it. -->
  <ItemGroup>
    <EmbeddedResource Include="localization/*.json" LogicalName="RdpsMeter.localization.%(Filename).json" />
  </ItemGroup>

  <!-- The binding verifier under tools/ is its own project; keep its sources and build output out of the mod, which
       otherwise globs every .cs in the repo (including the verifier's generated files) into itself. -->
  <ItemGroup>
    <Compile Remove="tools/**/*.cs" />
    <None Remove="tools/**/*" />
  </ItemGroup>
</Project>
