<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BindingVerifier</AssemblyName>
    <RootNamespace>RdpsMeter.BindingVerifier</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same Harmony the mod patches with; sts2/GodotSharp are loaded at runtime, not referenced. -->
    <Reference Include="0Harmony">
      <HintPath>../../lib/0Harmony.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
